<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

    <Appenders>

        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %C{1} - %msg%n"/>
        </Console>

        <!-- General Log File -->
        <File name="FileLogger"
              fileName="logs/app.log"
              append="true">

            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %C{1} - %msg%n"/>

        </File>

        <!-- Error Log File -->
        <File name="ErrorFileLogger"
              fileName="logs/error.log"
              append="true">

            <Filters>
                <ThresholdFilter
                    level="ERROR"
                    onMatch="ACCEPT"
                    onMismatch="DENY"/>
            </Filters>

            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss} [%t] %-5level %C{1} - %msg%n"/>

        </File>

    </Appenders>

     <Loggers>

        <!-- Framework Logger -->
        <Logger name="com.orangehrm"
                level="trace"
                additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileLogger"/>
            <AppenderRef ref="ErrorFileLogger"/>
        </Logger>

        <!-- Root Logger -->
        <Root level="error">
            <AppenderRef ref="Console"/>
        </Root>

    </Loggers>
    
	
	
</Configuration>


